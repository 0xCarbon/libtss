{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2021"],
		"module": "ESNext",
		"moduleResolution": "node",
		"rootDir": "./src",
		"outDir": "./lib",
		"declaration": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["jest", "node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/__tests__/**/*.ts"]
}
